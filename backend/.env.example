# Contoh konfigurasi backend. Salin ke .env lokal dan isi kredensial serta URI database yang sesuai.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/e_resep

# Primary frontend origin.
CLIENT_URL=http://localhost:5173

# Optional: additional comma-separated frontend origins.
# Example:
# CLIENT_URLS=http://localhost:5173,http://localhost:5174

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=rems_session
GRIDFS_BUCKET=resepFiles
MAX_FILE_SIZE_MB=5

# Gmail SMTP defaults. Use a Gmail App Password (not your ordinary Google account password).
# For another SMTP provider, replace host, port, username, password, and sender as required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM=REMS <your-gmail-address@gmail.com>
PASSWORD_RESET_REQUEST_LIMIT=5

# MongoDB Database Tools (sesuaikan dengan lokasi mongodump.exe di komputer Anda).
MONGODUMP_PATH=C:/Users/User/Downloads/mongodb-database-tools-windows-x86_64-100.20.1/mongodb-database-tools-windows-x86_64-100.20.1/bin/mongodump.exe
# Folder tujuan backup yang ditampilkan setelah perintah npm run backup berhasil.
BACKUP_DIR=C:/REMS-Backup
